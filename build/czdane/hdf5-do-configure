#!/bin/bash

ROOT=$(dirname $(realpath $0))

STARTDIR=$(pwd)

MPI_ROOT=/usr/tce/packages/mvapich2/mvapich2-2.3.7-intel-2023.2.1

mkdir $ROOT/hdf5-build
cd $ROOT/hdf5-build

CC=$MPI_ROOT/bin/mpicc CXX=$MPI_ROOT/bin/mpicxx \
    $ROOT/hdf5-src/configure \
    --prefix=$ROOT/hdf5 \
    --enable-shared \
    --enable-parallel

cd $STARTDIR
