function(extract_graph_schur_metric log_path expected_backend out_seconds out_dofs out_norm)
  if (NOT EXISTS "${log_path}")
    message(FATAL_ERROR "Missing Phase 0 tensor graph-norm Schur timing log: ${log_path}")
  endif()

  file(READ "${log_path}" log_contents)
  string(REGEX MATCHALL "PHASE0_TIMING event=tensor_graph_schur_micro_apply[^\n\r]*" graph_lines "${log_contents}")
  list(LENGTH graph_lines graph_line_count)
  if (graph_line_count EQUAL 0)
    message(FATAL_ERROR "No tensor_graph_schur_micro_apply timing line found in ${log_path}")
  endif()

  math(EXPR last_graph_line_index "${graph_line_count} - 1")
  list(GET graph_lines ${last_graph_line_index} graph_line)

  if (NOT graph_line MATCHES "backend=${expected_backend}")
    message(FATAL_ERROR "Expected backend=${expected_backend} in latest graph Schur timing line from ${log_path}; got: ${graph_line}")
  endif()
  if (NOT graph_line MATCHES "seconds=([^ ]+)")
    message(FATAL_ERROR "No seconds field found in latest graph Schur timing line from ${log_path}: ${graph_line}")
  endif()
  set(seconds "${CMAKE_MATCH_1}")
  if (NOT graph_line MATCHES "trial_dofs=([0-9]+)")
    message(FATAL_ERROR "No trial_dofs field found in latest graph Schur timing line from ${log_path}: ${graph_line}")
  endif()
  set(trial_dofs "${CMAKE_MATCH_1}")
  if (NOT graph_line MATCHES "output_norm=([^ ]+)")
    message(FATAL_ERROR "No output_norm field found in latest graph Schur timing line from ${log_path}: ${graph_line}")
  endif()
  set(output_norm "${CMAKE_MATCH_1}")

  if (NOT output_norm GREATER 0.0)
    message(FATAL_ERROR "Expected a nonzero graph Schur output norm in ${log_path}; got ${output_norm}")
  endif()

  set(${out_seconds} "${seconds}" PARENT_SCOPE)
  set(${out_dofs} "${trial_dofs}" PARENT_SCOPE)
  set(${out_norm} "${output_norm}" PARENT_SCOPE)
endfunction()

if (NOT DEFINED ASSEMBLED_LOG)
  message(FATAL_ERROR "ASSEMBLED_LOG is required")
endif()
if (NOT DEFINED MATRIX_FREE_LOG)
  message(FATAL_ERROR "MATRIX_FREE_LOG is required")
endif()

extract_graph_schur_metric("${ASSEMBLED_LOG}" "assembled_crs_graph_schur" assembled_seconds assembled_trial_dofs assembled_output_norm)
extract_graph_schur_metric("${MATRIX_FREE_LOG}" "matrix_free_graph_schur" matrix_free_seconds matrix_free_trial_dofs matrix_free_output_norm)

if (NOT assembled_trial_dofs STREQUAL matrix_free_trial_dofs)
  message(FATAL_ERROR "Phase 0 graph Schur trial DOF mismatch: assembled=${assembled_trial_dofs}, matrix_free=${matrix_free_trial_dofs}")
endif()

if (NOT assembled_output_norm STREQUAL matrix_free_output_norm)
  message(FATAL_ERROR "Phase 0 graph Schur output norm mismatch: assembled=${assembled_output_norm}, matrix_free=${matrix_free_output_norm}")
endif()

message(STATUS "PHASE0_GRAPH_SCHUR_COMPARISON assembled_seconds=${assembled_seconds} matrix_free_seconds=${matrix_free_seconds} trial_dofs=${assembled_trial_dofs} output_norm=${assembled_output_norm}")
